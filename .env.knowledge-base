# AWS Knowledge Base Configuration
# Add these lines to your .env file after creating the Knowledge Base

# Replace with your actual Knowledge Base ID from AWS Console
AWS_KNOWLEDGE_BASE_ID=your-knowledge-base-id-here

# Replace with your actual Data Source ID from AWS Console  
AWS_KNOWLEDGE_BASE_DATA_SOURCE_ID=your-data-source-id-here

# S3 bucket for knowledge content
AWS_S3_KNOWLEDGE_BUCKET=eyecare-video-knowledge-130799455554

# AWS region
AWS_REGION=us-east-1

# Instructions:
# 1. Create Knowledge Base in AWS Console (see guide above)
# 2. Copy the Knowledge Base ID and Data Source ID
# 3. Replace the placeholder values above
# 4. Copy these lines to your .env file
