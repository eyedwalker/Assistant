# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai-assistant-platform?retryWrites=true&w=majority

# AI Services
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# AWS Bedrock Configuration
USE_BEDROCK=false  # Set to 'true' to use AWS Bedrock instead of direct Anthropic API
AWS_ACCESS_KEY_ID=your-aws-access-key  # Optional if using IAM roles
AWS_SECRET_ACCESS_KEY=your-aws-secret-key  # Optional if using IAM roles
AWS_BEDROCK_REGION=us-east-1  # AWS region for Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0  # Model to use
BEDROCK_GUARDRAIL_ID=  # Optional: Guardrail ID for content filtering

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=ai-assistant-documents
S3_BUCKET_REGION=us-east-1

# AWS Infrastructure (OpenSearch & Lambda)
AWS_S3_BUCKET=eyecare-ai-content-dev-123456789012
AWS_OPENSEARCH_ENDPOINT=https://eyecare-ai-search-dev-abc123.us-east-1.es.amazonaws.com
AWS_API_ENDPOINT=https://abcd1234.execute-api.us-east-1.amazonaws.com/dev
OPENSEARCH_INDEX_NAME=ai-assistant-rag

# Authentication
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=your-jwt-secret-here

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SSL Configuration (for development)
NODE_TLS_REJECT_UNAUTHORIZED=0
NODE_OPTIONS=--tls-cipher-list=DEFAULT@SECLEVEL=0

# Vimeo API (optional - for video processing)
# Get from: https://developer.vimeo.com/apps
# 1. Create new app
# 2. Go to Authentication tab
# 3. Generate access token with Public, Private, Video Files scopes
VIMEO_ACCESS_TOKEN=your-vimeo-access-token

# Vector Database (Optional - choose one)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your-weaviate-api-key

# Processing Configuration
MAX_CONCURRENT_EXTRACTIONS=5
MAX_DOCUMENT_SIZE_MB=50
DEFAULT_CRAWL_DEPTH=3
PROCESSING_TIMEOUT_SECONDS=300

# Security Configuration
ENABLE_PHI_SCANNING=true
ENABLE_AUDIT_LOGGING=true
SESSION_TIMEOUT_MINUTES=60

# Monitoring & Analytics
ENABLE_ANALYTICS=true
LOG_LEVEL=info
