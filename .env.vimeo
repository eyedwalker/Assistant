# Vimeo Integration Configuration
# Add these to your .env file

# Vimeo API Access Token
# Get from: https://developer.vimeo.com/apps
VIMEO_ACCESS_TOKEN=your_vimeo_access_token_here

# Price Comparison API Keys (Optional but recommended)
# SerpAPI for Google Shopping results
# Get from: https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# Authentication Secret
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3001
