# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai-assistant-platform?retryWrites=true&w=majority

# AI Services
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=ai-assistant-documents
S3_BUCKET_REGION=us-east-1

# Authentication
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=your-jwt-secret-here

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SSL Configuration (for development)
NODE_TLS_REJECT_UNAUTHORIZED=0
NODE_OPTIONS=--tls-cipher-list=DEFAULT@SECLEVEL=0

# Vector Database (Optional - choose one)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your-weaviate-api-key

# Processing Configuration
MAX_CONCURRENT_EXTRACTIONS=5
MAX_DOCUMENT_SIZE_MB=50
DEFAULT_CRAWL_DEPTH=3
PROCESSING_TIMEOUT_SECONDS=300

# Security Configuration
ENABLE_PHI_SCANNING=true
ENABLE_AUDIT_LOGGING=true
SESSION_TIMEOUT_MINUTES=60

# Monitoring & Analytics
ENABLE_ANALYTICS=true
LOG_LEVEL=info
